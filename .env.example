# AutoClip Local — Environment Configuration
# Salin file ini ke .env dan sesuaikan nilainya.

# Database (path relatif ke root proyek, bukan folder backend/)
DATABASE_URL=sqlite+aiosqlite:///./data/autoclip.db

# Storage (path relatif ke root proyek)
STORAGE_ROOT=./storage
ASSETS_ROOT=./assets

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.1:8b

# Whisper
DEFAULT_WHISPER_MODEL=large-v3

# Pexels (opsional, non-blocking)
PEXELS_API_KEY=

# Server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
